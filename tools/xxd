#!/usr/bin/env python3
import sys


def main() -> int:
    args = sys.argv[1:]
    if args != ["-r", "-p"]:
        sys.stderr.write("local xxd shim only supports: xxd -r -p\n")
        return 2

    data = sys.stdin.read()
    hex_text = "".join(data.split())
    try:
        sys.stdout.buffer.write(bytes.fromhex(hex_text))
    except ValueError as exc:
        sys.stderr.write(f"invalid hex input: {exc}\n")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
